    {"label": "book", "prompts": ["book"]},
    {"label": "card", "prompts": ["card", "playing card", "index card"]},
    {"label": "paper", "prompts": ["sheet of paper"]},
    {"label": "bottle", "prompts": ["bottle", "water bottle"]},
    {"label": "cup", "prompts": ["cup", "mug"]},
    {"label": "fan", "prompts": ["electric fan", "fan"]},
