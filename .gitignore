# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.pytest_cache/
venv/
.env

# Trained weights & generated data (large / reproducible)
backend/recognition/weights/*.pt
backend/recognition/fonts/*
!backend/recognition/fonts/.gitkeep
synth_preview/
data/real/
work/

# Phone web app: files that are downloaded or rebuilt, not authored
#   ONNX Runtime Web      python tools/fetch_web_runtime.py
#   object model          python -m backend.objects.build      (AGPL-licensed weights)
#   browser-test scenes   written by the tests
# (The small formula model, backend/static/models/formula_rec.*, IS kept, so the
#  app can read formulas straight after a clone.)
backend/static/vendor/ort/
backend/static/models/objects*
backend/static/test/
# Assist app: pretrained text and speech models   python tools/fetch_assist_models.py
# (The small resistor reader, backend/static/models/resistor.*, IS kept: it is trained here.)
backend/static/models/assist/

.claude

# Scratch
_*.png
_*.log
training.log
.DS_Store

# Android build outputs and local SDK configuration
dist/
clients/glasses/android/.gradle/
clients/glasses/android/**/build/
clients/glasses/android/local.properties
*.jks
*.keystore
